"""Synthetic tensor boundary checks; no financial data or optimizer."""
import importlib.util
import json
from pathlib import Path
import unittest
from unittest.mock import patch
import numpy as np
import torch
from tradingagents.research.onchain_replication.evaluation import feature_hash
from tradingagents.research.onchain_replication.model import GraphEncoder

HERE=Path(__file__).resolve().parent

def api():
    path=HERE/'boundary.py'
    assert path.exists(),'bounded tensor boundary missing'
    spec=importlib.util.spec_from_file_location('feature_boundary',path)
    module=importlib.util.module_from_spec(spec);spec.loader.exec_module(module)
    return module

class Tests(unittest.TestCase):
    def fixture(self):
        return np.array([[0,.25],[.5,1],[.75,0]],dtype=np.float32),np.array([[0,1],[1,2]],dtype=np.int64)

    def convert(self,m,mcm,edges,**kwargs):
        options=dict(expected_hash=feature_hash({'mcm':mcm,'edge_index':edges}),
            max_numeric_bytes=130,chunk_entries=2,lease=lambda:None)
        options.update(kwargs)
        return m.materialize(mcm,edges,**options)

    def test_exact_independent_cpu_tensors_and_model_compatibility(self):
        m=api();a,e=self.fixture();out=self.convert(m,a,e)
        self.assertEqual(out['mcm'].dtype,torch.float32);self.assertEqual(out['edge_index'].dtype,torch.int64)
        self.assertEqual(out['mcm'].device.type,'cpu');self.assertFalse(out['mcm'].requires_grad)
        ref={'mcm':torch.tensor(a),'edge_index':torch.tensor(e)}
        self.assertEqual(feature_hash(out),feature_hash(ref))
        config=json.loads((HERE.parents[1]/'config/model.json').read_text());config['mcm_input']=2
        torch.manual_seed(11);model=GraphEncoder(config).eval()
        with torch.no_grad():torch.testing.assert_close(model(**out),model(**ref),rtol=0,atol=0)
        a[:]=0;e[:]=0
        torch.testing.assert_close(out['mcm'],ref['mcm'],rtol=0,atol=0)
        torch.testing.assert_close(out['edge_index'],ref['edge_index'],rtol=0,atol=0)

    def test_layouts_and_zero_edges_preserve_maintained_hash(self):
        m=api();a,e=self.fixture()
        for x,y in ((np.asfortranarray(a),np.asfortranarray(e)),(a[::-1],e[:,::-1]),(a,e[:,:0])):
            with self.subTest(strides=(x.strides,y.strides)):
                out=self.convert(m,x,y);self.assertEqual(feature_hash(out),feature_hash({'mcm':x,'edge_index':y}))

    def test_budget_and_bad_input_refuse_before_tensor_allocation(self):
        m=api();a,e=self.fixture()
        bad=[(a,e,{'max_numeric_bytes':129}),(a,e,{'chunk_entries':True}),
            (a,e,{'lease':None}),(a,e,{'expected_hash':'0'*64}),
            (a.astype('float64'),e,{}),(a,e.astype('int32'),{}),
            (a[:0],e,{}),(a,e.T[:1],{}),
            (a,e,{'max_numeric_bytes':True}),(a,e,{'chunk_entries':65537})]
        for x,y,options in bad:
            with self.subTest(options=options,dtypes=(x.dtype,y.dtype)),patch.object(torch,'empty',side_effect=AssertionError('premature tensor allocation')):
                with self.assertRaises(ValueError):self.convert(m,x,y,**options)
        for value in (np.nan,np.inf,-.1,1.01):
            x=a.copy();x[-1,-1]=value
            with self.subTest(value=value),patch.object(torch,'empty',side_effect=AssertionError('premature tensor allocation')):
                with self.assertRaises(ValueError):self.convert(m,x,e)
        for endpoint in (-1,3):
            y=e.copy();y[-1,-1]=endpoint
            with self.subTest(endpoint=endpoint),patch.object(torch,'empty',side_effect=AssertionError('premature tensor allocation')):
                with self.assertRaises(ValueError):self.convert(m,a,y)

    def test_drift_during_lease_and_copy_is_rejected(self):
        m=api();a,e=self.fixture();calls=[]
        def lease():
            calls.append(1)
            if len(calls)==3:a[-1,-1]=.125
        with self.assertRaises(ValueError):self.convert(m,a,e,lease=lease)
        a,e=self.fixture();original=np.copyto;changed=[]
        def copy(*args,**kwargs):
            original(*args,**kwargs)
            if not changed:a[-1,-1]=.125;changed.append(1)
        with patch.object(np,'copyto',side_effect=copy):
            with self.assertRaises(ValueError):self.convert(m,a,e)

    def test_lease_failure_propagates_without_allocation(self):
        m=api();a,e=self.fixture()
        def lease():raise RuntimeError('owner closed')
        with patch.object(torch,'empty',side_effect=AssertionError('premature allocation')):
            with self.assertRaisesRegex(RuntimeError,'owner closed'):self.convert(m,a,e,lease=lease)

if __name__=='__main__':unittest.main(verbosity=2)
