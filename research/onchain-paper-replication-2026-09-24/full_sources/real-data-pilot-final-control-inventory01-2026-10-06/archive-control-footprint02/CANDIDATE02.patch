+                while offset<before.st_size:
+                    prefix=os.read(fd,8);require(len(prefix)==8,'partial packed archive header')
+                    nl,rl=struct.unpack('<II',prefix);require(0<nl<=32 and rl<=8192,'packed archive frame bounds')
