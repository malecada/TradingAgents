+        cache_weight_bytes=0,cache_validity_bytes=0,cache_oversize_chunks=0,cache_peak_retained_bytes=0,cache_hit_chunks=0,cache_allocations=0,cache_allocated_bytes=0,cache_released_bytes=0)
