+def _claim_failure_note(primary, label, error):
+    # Diagnostic construction must never replace the original failure.
+    try:
+        note = label + ': ' + type(error).__name__
+        try:
+            note += ': ' + str(error)[:1024]
+        except BaseException:
+            pass
+        BaseException.add_note(primary, note)
+    except BaseException:
+        pass
+
