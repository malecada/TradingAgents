+                else:
+                    _claim_failure_note(primary, 'drained claim index '+str(index), later)
+        if cleanup_error is not None:
+            if original_primary is None:
+                raise cleanup_error
+            _claim_failure_note(primary, 'claim worker cleanup uncertain', cleanup_error)
