 def canonical(value):return json.dumps(value,sort_keys=True,separators=(',',':'),ensure_ascii=False,allow_nan=False).encode()
 def fatal(error):return error is not None and (not isinstance(error,Exception) or isinstance(error,(MemoryError,RecursionError)))
 def preserve(first,later):return first if fatal(first) else later if fatal(later) or first is None else first
+
+def preserve_owned(first,later,cleanup_type):
+    # cleanup_type is the source-authenticated canonical owned_io class, never
+    # an invented error label or user-provided receipt field.
+    if first is None:return later
+    actual=lambda e:fatal(e) and not isinstance(e,cleanup_type)
+    if actual(first):return first
+    if actual(later):return later
+    if isinstance(later,cleanup_type) and isinstance(first,Exception):return later
+    return first
+
+def sync_owned_directory(path,cleanup_type):
+    fd=os.open(path,os.O_RDONLY|os.O_DIRECTORY|os.O_NOFOLLOW);first=None
+    try:os.fsync(fd)
+    except BaseException as error:first=preserve_owned(first,error,cleanup_type)
+    try:os.close(fd)
+    except BaseException as error:first=preserve_owned(first,error,cleanup_type)
+    if first is not None:raise first
