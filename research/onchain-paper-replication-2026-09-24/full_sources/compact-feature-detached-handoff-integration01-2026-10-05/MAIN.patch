+ terminal.check();owner=terminal._owner;bound=owner.bound;run=bound._run;ad=run.admission
+ require(owner.closed and owner.closing and not owner.poisoned and owner.active is None,'genuine completed owner required')
+ require(set(owner.stages)==set(owner.required) and all(s.closed for s in owner.stages.values()),'every original stage must be complete')
+ selected=json.loads(run.read_input('execution_job'))['payload']['representation_jobs'][bound.record['representation']]
+ item=json.loads(run.read_input(selected['plan_input']))['producers'][bound.record['producer']]
+ require(type(input_name)is str and input_name in ad.inputs and selected.get('compact_detached_input')==item.get('compact_detached_input')==input_name,'explicit identical registered detached role required')
+ policy=json.loads(run.read_input(input_name));require(policy=={'schema_version':1,'kind':'compact-detached-sampled-v1','lifetime':'original-reader-sampled-content-v1','metadata_limit':LIMIT},'no invented lifetime authority')
