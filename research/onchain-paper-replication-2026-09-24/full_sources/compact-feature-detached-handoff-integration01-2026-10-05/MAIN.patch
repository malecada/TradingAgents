+admit fitting. This changed assurance must be reviewed/registered before a pilot.
+"""
+import hashlib,json,weakref,math
+from pathlib import Path
+
+SELF='tradingagents/research/onchain_replication/compact_detached_handoff.py'
+LIMIT=2*1024**2
+STATUS='DETACHED_SAMPLED_COMPONENT_HANDOFF_V1'
+def require(v,message):
+ if not v:raise ValueError(message)
+def encoded(value):
+ def visit(x,depth=0):
+  require(depth<=32,'detached metadata depth exceeded')
+  if type(x) in (str,int,bool,type(None)):return
+  if type(x)is float:require(math.isfinite(x),'finite metadata scalar');return
+  if type(x)is list:
+   require(len(x)<=32768,'metadata list bound');[visit(y,depth+1) for y in x];return
+  if type(x)is dict:
+   require(len(x)<=32768 and all(type(k)is str for k in x),'metadata map bound');[visit(y,depth+1) for y in x.values()];return
+  raise ValueError('only detached primitive metadata; no producer objects or callbacks')
+ visit(value);raw=json.dumps(value,sort_keys=True,separators=(',',':'),allow_nan=False).encode();require(len(raw)<=LIMIT,'detached metadata bound');return raw
+class Record:
+ """Detached bytes only, explicitly not Receipt/PreparedFeatures/Mapping."""
+ __slots__=('_raw',)
+ def __init__(self,value):
+  require(type(value)is dict and value.get('status')==STATUS,'metadata-only disposition required');object.__setattr__(self,'_raw',encoded(value))
+ def __setattr__(self,k,v):raise AttributeError('immutable detached metadata')
+ def metadata(self):return json.loads(self._raw)
+ def require_loader(self):require(self.metadata().get('lifetime')=='original-reader-sampled-content-v1','original sampled component reader required')
+
+def capture(prepared,terminal,*,input_name):
