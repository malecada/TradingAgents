+  compact_owner.entries(path,names,required=names);info=path.lstat();namespaces.append({'path':str(path),'members':sorted(names),'device':info.st_dev,'inode':info.st_ino})
+
+ value={'status':STATUS,'schema_version':1,'source':ad.source,'experiment':ad.experiment_id,'claim_sha256':run._claim_sha256,'root':str(ad.root),'policy_input':input_name,'policy_sha256':ad.inputs[input_name]['sha256'],'source_sha256':pin,'terminal':record,'binding':binding,'components':refs,'metadata_pins':snapshots,'scientific_feature_admission':False,'lifetime':policy['lifetime'],'guard':{'policy':thaw(bound._resources),'owner':thaw(bound._owner),'base':str(bound._base)},'runtime_hash':bound.context['runtime_hash'],'numerical_source':thaw(bound.record['numerical_source']),'settings':thaw(prepared.features._mapping._policy),'graph_root':str(base),'saved_namespaces':namespaces,'terminal_attempt':str(attempt),'failure_roots':sorted({str(owner.root),str(owner.root.parent),*[str(Path(n).parent) for n in snapshots]})}
