+def check_metadata(record,run):
+ from ..lifecycle import ResearchRun
+ from . import matching_owner,compact_owner
+ require(type(record)is Record and isinstance(run,ResearchRun),'actual run and detached metadata required')
+ v=record.metadata();ad=run.admission;run._active();run._check_source();run._check_inputs()
+ require((str(ad.root),ad.source,ad.experiment_id,run._claim_sha256)==(v['root'],v['source'],v['experiment'],v['claim_sha256']),'same genuine run/source/claim required')
