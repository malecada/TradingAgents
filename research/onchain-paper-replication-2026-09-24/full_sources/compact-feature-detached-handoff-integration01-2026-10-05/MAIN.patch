+ hashes=prepared.features.verified_hashes();terminal.check();record=thaw(terminal.record)
+ publication=native._metadata(Path(record['publication']['path']),record['publication']['sha256'],LIMIT)
+ binding=publication['closure']['binding'];require(binding==thaw(prepared.binding) and hashes==binding['feature_hashes'],'complete published feature binding differs')
