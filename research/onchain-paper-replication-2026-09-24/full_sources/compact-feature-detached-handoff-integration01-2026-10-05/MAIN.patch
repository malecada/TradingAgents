+def prepare(prepared,terminal,*,input_name):
+ from . import compact_native_features as native
+ record=capture(prepared,terminal,input_name=input_name);record.require_loader()
+ run=terminal._owner.bound._run;authority=Authority(record,run,_key=_ISSUED);v=authority.lease();m=native._api()
+ mapping=m._NativeMap(run.admission.root,v['components'],v['settings'],lease=authority.lease,read_lease=authority.lease)
