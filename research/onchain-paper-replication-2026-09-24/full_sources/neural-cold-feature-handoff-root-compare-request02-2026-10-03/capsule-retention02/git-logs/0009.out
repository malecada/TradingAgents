            require(not os.path.lexists(self.root/events._name(index))
                and io._read(self.fd, _chunk(index)+'.json', io.META_LIMIT) == mapping_raw
                and io._read(self.fd, f'disposed-{index:012d}.json', io.META_LIMIT) == disposed,
