+def _training_metadata(projected):
+    """Exact observer whitelist from an already checked population projection.
+
+    Publication provides the genuine source and output lineage. This pure
+    conversion confers no feature authority or population capacity claim.
+    """
+    membership=projected['membership']
+    value={'schema_version':1,'train_hash':membership['train_hash'],
+        'fold_hash':membership['fold_hash'],'source_hashes':list(membership['source_hashes']),
+        'rows':[{k:row[k] for k in ('decision_at','input_dates','graph_hashes','graph_available_at')}
+            for row in projected['rows'] if row['partition']=='train'],
+        'exclusions':[dict(row) for row in projected['exclusions'] if row['partition']=='train']}
+    require(len(value['rows'])<=2048 and len(value['exclusions'])<=8192,'observer metadata population bound exceeded')
+    encode(value,OUTPUT_LIMIT)
+    return value
+
+def training_metadata(population,binding,assembly,components):
+    """Validate original population and emit only the existing observer schema."""
+    return _training_metadata(project(population,binding,assembly,components))
