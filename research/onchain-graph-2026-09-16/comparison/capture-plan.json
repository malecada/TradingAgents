{
  "base_url": "https://aws-public-blockchain.s3.us-east-2.amazonaws.com/",
  "required_types": {
    "hash": "string",
    "block_hash": "string",
    "block_number": "int64",
    "block_timestamp": "timestamp[ns]",
    "transaction_index": "int64",
    "from_address": "string",
    "to_address": "string",
    "value": "double",
    "receipt_status": "int64"
  },
  "block_required_types": {
    "number": "int64",
    "hash": "string",
    "parent_hash": "string",
    "timestamp": "timestamp[ns]",
    "transaction_count": "int64"
  },
  "limits": {
    "max_logical_bytes": 8589934592,
    "max_footer_bytes": 4194304,
    "max_projection_bytes": 268435456,
    "max_response_bytes": 33554432,
    "max_block_bytes": 16777216,
    "max_requests": 2100,
    "max_total_bytes": 2147483648,
    "max_day_bytes": 285212672,
    "max_day_requests": 291,
    "timeout_seconds": 30
  }
}
