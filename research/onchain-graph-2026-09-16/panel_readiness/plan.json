{
  "base_url": "https://aws-public-blockchain.s3.us-east-2.amazonaws.com/",
  "years": [
    2022,
    2023,
    2024
  ],
  "tables": [
    "blocks",
    "transactions"
  ],
  "sample_dates": [
    "2022-01-01",
    "2022-04-01",
    "2022-07-01",
    "2022-10-01",
    "2023-01-01",
    "2023-04-01",
    "2023-07-01",
    "2023-10-01",
    "2024-01-01",
    "2024-04-01",
    "2024-07-01",
    "2024-10-01"
  ],
  "max_keys": 1000,
  "max_requests": 54,
  "max_footer_bytes": 4194304,
  "max_response_bytes": 4194312,
  "max_total_bytes": 33554432,
  "timeout_seconds": 30,
  "required_types": {
    "blocks": {
      "number": "int64",
      "hash": "string",
      "parent_hash": "string",
      "timestamp": "timestamp[ns]",
      "transaction_count": "int64"
    },
    "transactions": {
      "hash": "string",
      "block_hash": "string",
      "block_number": "int64",
      "block_timestamp": "timestamp[ns]",
      "transaction_index": "int64",
      "from_address": "string",
      "to_address": "string",
      "value": "double",
      "receipt_status": "int64"
    }
  },
  "no_pagination": true,
  "no_retry": true,
  "no_substitution": true,
  "transaction_rows_permitted": 0
}
