ont-size:12px;color:#B7BDC6;padding:0;height:auto;width:100%;overflow-x:auto;-webkit-scrollbar-width:none;-moz-scrollbar-width:none;-ms-scrollbar-width:none;scrollbar-width:none;}.css-16ei2oe div{-webkit-flex-shrink:0;-ms-flex-negative:0;flex-shrink:0;}.css-16ei2oe svg{margin-bottom:8px;}.css-16ei2oe::-webkit-scrollbar{display:none;}</style><div class="css-16ei2oe"><style data-emotion-css="1kfsafv">.css-1kfsafv{box-sizing:border-box;margin:0;min-width:0;color:#F0B90B;margin-bottom:8px;-webkit-flex-shrink:0;-ms-flex-negative:0;flex-shrink:0;-webkit-text-decoration:none;text-decoration:none;color:#848E9C;}.css-1kfsafv:hover{color:#F0B90B;-webkit-text-decoration:underline;text-decoration:underline;}</style><a data-bn-type="link" href="/en" class="css-1kfsafv"><style data-emotion-css="1cjl26j">.css-1cjl26j{box-sizing:border-box;margin:0;min-width:0;font-weight:400;font-size:14px;line-height:20px;}</style><div data-bn-type="text" class="css-1cjl26j">Home</div></a><style data-emotion-css="1bobwd">.css-1bobwd{box-sizing:border-box;margin:0;min-width:0;margin-left:8px;margin-right:8px;line-height:1;color:#474D57;}</style><div class="css-1bobwd"><style data-emotion-css="3kwgah">.css-3kwgah{box-sizing:border-box;margin:0;min-width:0;color:currentColor;width:24px;height:24px;font-size:24px;fill:#EAECEF;fill:currentColor;width:1em;height:1em;}</style><svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" class="css-3kwgah"><path d="M14.65 12.24l-4.24 4.24L9 15.06l2.82-2.82L9 9.42 10.41 8l4.24 4.24z" fill="currentColor"></path></svg></div><a data-bn-type="link" href="/en/support" class="css-1kfsafv"><div data-bn-type="text" class="css-1cjl26j">Support Center</div></a><div class="css-1bobwd"><svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" class="css-3kwgah"><path d="M14.65 12.24l-4.24 4.24L9 15.06l2.82-2.82L9 9.42 10.41 8l4.24 4.24z" fill="currentColor"></path></svg></div><a data-bn-type="link" href="/en/support/faq" class="css-1kfsafv"><div data-bn-type="text" class="css-1cjl26j">FAQ</div></a><div class="css-1bobwd"><svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" class="css-3kwgah"><path d="M14.65 12.24l-4.24 4.24L9 15.06l2.82-2.82L9 9.42 10.41 8l4.24 4.24z" fill="currentColor"></path></svg></div><a data-bn-type="link" href="/en/support/faq/crypto-derivatives?c=4&amp;navId=4" class="css-1kfsafv"><div data-bn-type="text" class="css-1cjl26j">Crypto Derivatives</div></a><div class="css-1bobwd"><svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" class="css-3kwgah"><path d="M14.65 12.24l-4.24 4.24L9 15.06l2.82-2.82L9 9.42 10.41 8l4.24 4.24z" fill="currentColor"></path></svg></div><a data-bn-type="link" href="/en/support/faq/futures-contracts?c=4&amp;navId=4#18" class="css-1kfsafv"><div data-bn-type="text" class="css-1cjl26j">Futures Contracts</div></a><div class="css-1bobwd"><svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" class="css-3kwgah"><path d="M14.65 12.24l-4.24 4.24L9 15.06l2.82-2.82L9 9.42 10.41 8l4.24 4.24z" fill="currentColor"></path></svg></div><a data-bn-type="link" href="/en/support/faq/introduction-to-binance-futures?c=4&amp;navId=4#18-36" class="css-1kfsafv"><div data-bn-type="text" class="css-1cjl26j">Introduction to Binance Futures</div></a><div class="css-1bobwd"><svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" class="css-3kwgah"><path d="M14.65 12.24l-4.24 4.24L9 15.06l2.82-2.82L9 9.42 10.41 8l4.24 4.24z" fill="currentColor"></path></svg></div><style data-emotion-css="1a7cp3m">.css-1a7cp3m{box-sizing:border-box;margin:0;min-width:0;font-weight:500;font-size:14px;line-height:20px;cursor:default;-webkit-flex-shrink:0;-ms-flex-negative:0;flex-shrink:0;margin-bottom:8px;color:#EAECEF;}</style><div data-bn-type="text" class="css-1a7cp3m">Binance Futures Fee Structure &amp; Fee Calculations</div></div><style data-emotion-css="14boeze">.css-14boeze{box-sizing:border-box;margin:0;min-width:0;position:absolute;top:0;right:0;background:linear-gradient(270deg,#181A20 0%,rgba(24,26,32,0) 100%);height:34px;width:60px;}</style><div class="css-14boeze"></div></div></div><style data-emotion-css="1blp5cd">.css-1blp5cd{box-sizing:border-box;margin:0;min-width:0;color:#EAECEF;font-size:20px;font-weight:500;line-height:28px;}@media screen and (min-width:768px){.css-1blp5cd{font-size:32px;font-weight:600;line-height:40px;}}</style><h1 data-bn-type="text" class="css-1blp5cd">Binance Futures Fee Structure &amp; Fee Calculations</h1><style data-emotion-css="c40kel">.css-c40kel{box-sizing:border-box;margin:0;min-width:0;font-weight:500;font-size:14px;line-height:20px;color:#EAECEF;padding-top:8px;}</style><div data-bn-type="text" class="css-c40kel">2019-09-09 13:39</div><style data-emotion-css="ujx439">.css-ujx439{box-sizing:border-box;margin:0;min-width:0;padding-top:40px;overflow-wrap:break-word;padding-bottom:64px;}.css-ujx439 img{max-width:526px;}.css-ujx439 a:not(.no-cover),.css-ujx439 a:not(.no-cover) > *,.css-ujx439 a:not(.no-cover) > * > *{color:#F0B90B;word-break:break-all;-webkit-text-decoration:none;text-decoration:none;}.css-ujx439 figure{margin-left:0;}.css-ujx439 figure + figure img{padding-top:0;padding-bottom:12px;}.css-ujx439 img{margin-left:0;}.css-ujx439 a:not(.no-cover):hover,.css-ujx439 a:not(.no-cover):hover > *{color:#F0B90B;-webkit-text-decoration:underline;text-decoration:underline;}.css-ujx439 div,.css-ujx439 h1,.css-ujx439 h2,.css-ujx439 h3,.css-ujx439 ul,.css-ujx439 ol,.css-ujx439 table > tbody > tr > td{color:#EAECEF;}</style><div id="support_article" class="css-ujx439"><style data-emotion-css="26lh8k">.css-26lh8k{box-sizing:border-box;margin:0;min-width:0;display:-webkit-box;display:-webkit-flex;display:-ms-flexbox;display:flex;-webkit-flex-direction:column;-ms-flex-direction:column;flex-direction:column;font-weight:400;}.css-26lh8k img{width:100%;}.css-26lh8k iframe{margin:auto;}.css-26lh8k figcaption{text-align:center;font-size:12px;line-height:24px;margin-top:-16px;margin-bottom:24px;color:#76808F;}@media screen and (min-width:768px){.css-26lh8k figcaption{font-size:12px;line-height:24px;margin-top:-12px;margin-bottom:32px;}}@media screen and (min-width:1024px){.css-26lh8k figcaption{font-size:12px;line-height:24px;margin-top:-12px;margin-bottom:32px;}}</style><article class="css-26lh8k"><style data-emotion-css="a15ggx">.css-a15ggx{box-sizing:border-box;margin:0;min-width:0;font-size:14px;line-height:24px;padding-top:4px;padding-bottom:12px;color:#1E2329;}@media screen and (min-width:768px){.css-a15ggx{font-size:16px;line-height:28px;}}@media screen and (min-width:1024px){.css-a15ggx{font-size:16px;line-height:28px;}}</style><div class="css-a15ggx">You can check your trading fee rate <style data-emotion-css="li4l4s">.css-li4l4s{box-sizing:border-box;margin:0;min-width:0;display:inline;color:#F0B90B;}.css-li4l4s:visited{color:#F0B90B;}.css-li4l4s:hover{color:#F0B90B;opacity:0.5;}</style><a href="/en/fee/futureFee" class="css-li4l4s">here</a>.</div><div class="css-a15ggx"><style data-emotion-css="1lohbqv">.css-1lohbqv{box-sizing:border-box;margin:0;min-width:0;font-weight:600;}</style><strong class="css-1lohbqv">Notes:</strong></div><style data-emotion-css="li43si">.css-li43si{box-sizing:border-box;margin:0;min-width:0;display:-webkit-box;display:-webkit-flex;display:-ms-flexbox;display:flex;-webkit-flex-direction:column;-ms-flex-direction:column;flex-direction:column;font-size:14px;line-height:24px;color:#1E2329;padding-top:4px;padding-bottom:12px;}@media screen and (min-width:768px){.css-li43si{font-size:16px;line-height:24px;}}@media screen and (min-width:1024px){.css-li43si{font-size:16px;line-height:24px;}}</style><ul class="css-li43si"><style data-emotion-css="16ebybl">.css-16ebybl{box-sizing:border-box;margin:0;min-width:0;margin-bottom:4px;}@media screen and (min-width:768px){.css-16ebybl{margin-bottom:16px;}}@media screen and (min-width:1024px){.css-16ebybl{margin-bottom:16px;}}.css-16ebybl:last-child{margin-bottom:0;}</style><li class="css-16ebybl">All spot market VIPs are also VIPs in the Futures market.</li><li class="css-16ebybl">Futures fee tiers mirror the spot market tiers but are generally lower. Please note that the volume requirement for each VIP tier is 5 times that of the spot market due to the leverage provided.</li><li class="css-16ebybl">Please refer to <a href="/en/support/faq/360031505011" class="css-li4l4s">Daily BNB Balance Calculation Mechanism.</a></li><li class="css-16ebybl">Users will receive a 10% discount on standard trading fees when they use BNB to pay for trading fees on the Binance Futures platform for USDⓈ-M Futures. Users will need to transfer BNB from their Spot Wallet to their USDⓈ-M Futures Wallet to receive the 10% discount. Please ensure that you have a sufficient BNB balance in your USDⓈ-M Futures Wallet to pay for the trading fees. The system will automatically deduct USDT as Futures trading fees and you will not be entitled to the discount.</li><li class="css-16ebybl">BNB transferred to the USDⓈ-M Futures Wallet can be used for fee discounts and collateral when Multi-Assets mode is enabled. For more details, please refer to <a href="/en/support/articles/360037809471" class="css-li4l4s">Binance Futures Trading Fee Discount Program - Save 10% With BNB</a></li></ul><style data-emotion-css="whcap1">.css-whcap1{box-sizing:border-box;margin:0;min-width:0;padding-top:28px;padding-bottom:12px;font-size:16px;line-height:24px;font-weight:500;color:#1E2329;}@media screen and (min-width:768px){.css-whcap1{font-size:20px;line-height:24px;}}@media screen and (min-width:1024px){.css-whcap1{font-size:24px;line-height:24px;}}</style><h2 class="css-whcap1">What Do &quot;Maker&quot; and &quot;Taker&quot; Mean?</h2><style data-emotion-css="7iasr7">.css-7iasr7{box-sizing:border-box;margin:0;min-width:0;padding-top:28px;padding-bottom:12px;font-size:14px;line-height:24px;font-weight:600;color:#1E2329;}@media screen and (min-width:768px){.css-7iasr7{font-size:16px;line-height:24px;}}@media screen and (min-width:1024px){.css-7iasr7{font-size:16px;line-height:24px;}}</style><h3 class="css-7iasr7">Taker</h3><div class="css-a15ggx">When you place an order that trades immediately before going on the order book, either filling partially or fully, those trades will be &quot;taker&quot; trades.</div><div class="css-a15ggx">Trades from market orders are always Takers, as market orders can never go on the order book. These trades are &quot;taking&quot; volume off of the order book, and therefore called the &quot;taker.&quot;</div><h3 class="css-7iasr7">Maker</h3><div class="css-a15ggx">When you place an order that goes on the order book partially or fully, such as a limit order, any subsequent trades coming from that order will be as a “maker.”</div><div class="css-a15ggx">These orders add volume to the order book, helping to &quot;make the market,&quot; and are therefore termed the &quot;maker&quot; for any subsequent trades.</div><h2 class="css-whcap1">How to calculate the commission for COIN-margined contracts?</h2><div class="css-a15ggx">Commission Fee = Notional Value * Fee Rate</div><div class="css-a15ggx">Notional Value = (Number of Contracts* Contract Size) / Trade Price</div><div class="css-a15ggx">For example, a regular user&#x27;s maker commission: 0.02%; taker commission: 0.05%</div><div class="css-a15ggx">Buy 10 BTCUSD 0925 quarterly contracts using a market order:</div><div class="css-a15ggx">Notional Value = (Number of Contracts * Contract Size) / Opening Price</div><div class="css-a15ggx">= (10 contracts * 100 USD) / 10,104 USD</div><div class="css-a15ggx">= 0.09897 BTC</div><div class="css-a15ggx">Taker commission fee: 0.09897 * 0.050% = 0.000049485 BTC</div><div class="css-a15ggx">After the price increases, sell 10 BTCUSD 0925 quarterly contracts using a limit order:</div><div class="css-a15ggx">Notional Value = (Number of Contracts * Contract Size) / Closing Price</div><div class="css-a15ggx">= (10 contracts * 100 USD) / 11,104 USD</div><div class="css-a15ggx">= 0.09 BTC</div><div class="css-a15ggx">Maker commission fee: 0.09 * 0.02% = 0.000018 BTC</div><h2 class="css-whcap1">How to calculate the commission of USDⓈ-margined contracts?</h2><div class="css-a15ggx">Commission Fee = Notional Value * Fee Rate</div><div class="css-a15ggx">Notional Value = Number of Contracts * Trade Price</div><div class="css-a15ggx">For example, regular user&#x27;s maker commission: 0.02%; taker commission: 0.05%</div><div class="css-a15ggx">Buy 1 BTC worth of BTCUSDT contract using a market order:</div><div class="css-a15ggx">Notional Value = Number of Contracts * Opening Price</div><div class="css-a15ggx">= 1 BTC * 10,104</div><div class="css-a15ggx">= 10,104</div><div class="css-a15ggx">Taker commission fee is paid: 10,104 * 0.05% = 5.052 USDT</div><div class="css-a15ggx">After the price rises, Sell 1 BTC worth of BTCUSDT contract using a limit order:</div><div class="css-a15ggx">Notional Value = Number of Contracts * Closing Price</div><div class="css-a15ggx">= 1 BTC * 11,104</div><div class="css-a15ggx">= 11,104</div><div class="css-a15ggx">Maker commission fee is paid: 11,104 * 0.02% = 2.2208 USDT</div></article></div></div><style data-emotion-css="1bzb8nq">.css-1bzb8nq{box-sizing:border-box;margin:0;min-width:0;display:none;}</style><aside class="css-1bzb8nq"><style data-emotion-css="qlcbj2">.css-qlcbj2{box-sizing:border-box;margin:0;min-width:0;position:-webkit-sticky;position:sticky;top:32px;}</style><div class="css-qlcbj2"><style data-emotion-css="1iwhalc">.css-1iwhalc{box-sizing:border-box;margin:0;min-width:0;display:-webkit-box;display:-webkit-flex;display:-ms-flexbox;display:flex;-webkit-flex-direction:row;-ms-flex-direction:row;flex-direction:row;-webkit-align-items:center;-webkit-box-align:center;-ms-flex-align:center;align-items:center;-webkit-box-pack:center;-webkit-justify-content:center;-ms-flex-pack:center;justify-content:center;gap:24px;}@media screen and (min-width:768px){.css-1iwhalc{-webkit-flex-direction:column;-ms-flex-direction:column;flex-direction:column;-webkit-align-items:flex-start;-webkit-box-align:flex-start;-ms-flex-align:flex-start;align-items:flex-start;gap:24px;}}@media screen and (min-width:1024px){.css-1iwhalc{gap:40px;}}</style><div class="css-1iwhalc"><div class="css-vurnku"><style data-emotion-css="l7x4y">.css-l7x4y{box-sizing:border-box;margin:0;min-width:0;display:-webkit-box;display:-webkit-flex;display:-ms-flexbox;display:flex;-webkit-align-items:center;-webkit-box-align:center;-ms-flex-align:center;align-items:center;margin-bottom:24px;}</style><div class="css-l7x4y"><style data-emotion-css="1vjjtb1">.css-1vjjtb1{box-sizing:border-box;margin:0;min-width:0;font-weight:500;font-size:20px;line-height:28px;color:#EAECEF;margin-right:8px;}</style><h6 data-bn-type="text" class="css-1vjjtb1">Share Post</h6></div><style data-emotion-css="baj9jn">.css-baj9jn{box-sizing:border-box;margin:0;min-width:0;display:-webkit-box;display:-webkit-flex;display:-ms-flexbox;display:flex;-webkit-flex-wrap:wrap;-ms-flex-wrap:wrap;flex-wrap:wrap;max-width:168px;}@media screen and (min-width:768px){.css-baj9jn{max-width:168px;}}@media screen and (min-width:1024px){.css-baj9jn{max-width:264px;}}</style><div class="css-baj9jn"><style data-emotion-css="1az42rj">.css-1az42rj{box-sizing:border-box;margin:0;min-width:0;color:#848E9C;width:24px;height:24px;font-size:24px;fill:#EAECEF;fill:#848E9C;width:1em;height:1em;margin-right:24px;}.css-1az42rj:hover{color:#EAECEF;}.css-1az42rj:last-child{margin-right:0px;}</style><svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" cursor="pointer" class="css-1az42rj"><path fill-rule="evenodd" clip-rule="evenodd" d="M3.04371 3.57629L9.99338 12.8687L3 20.4237H4.57397L10.6968 13.8092L15.6437 20.4237H21L13.6593 10.6087L20.169 3.57629H18.5951L12.9562 9.6682L8.39998 3.57629H3.04371ZM5.35834 4.73568H7.81903L18.685 19.2642H16.2243L5.35852 4.73568H5.35834Z" fill="currentColor"></