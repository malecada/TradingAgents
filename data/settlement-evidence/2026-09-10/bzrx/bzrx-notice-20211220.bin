wc">.css-1ajslwc{box-sizing:border-box;margin:0;min-width:0;margin-left:16px;display:grid;width:100%;grid-template-columns:1fr;gap:48px;padding-top:32px;}@media screen and (min-width:767px){.css-1ajslwc{margin-left:24px;grid-template-columns:1fr;padding-top:40px;}}@media screen and (min-width:1023px){.css-1ajslwc{margin-left:32px;grid-template-columns:1fr 304px;}}</style><div class="css-1ajslwc"><style data-emotion-css="17pixli">.css-17pixli{box-sizing:border-box;margin:0;min-width:0;margin-right:16px;}@media screen and (min-width:767px){.css-17pixli{margin-right:24px;}}@media screen and (min-width:1023px){.css-17pixli{margin-right:0;}}</style><article class="css-17pixli"><style data-emotion-css="adubd1">.css-adubd1{box-sizing:border-box;margin:0;min-width:0;overflow-wrap:break-word;font-size:20px;font-weight:500;line-height:28px;}@media screen and (min-width:767px){.css-adubd1{font-size:24px;font-weight:600;line-height:32px;}}@media screen and (min-width:1023px){.css-adubd1{font-size:28px;font-weight:600;line-height:36px;}}</style><h1 data-bn-type="text" class="css-adubd1">Binance Will Support the bZx Protocol Token (BZRX) Token Swap &amp; Redenomination Plan to OokiDAO Token (OOKI)</h1><style data-emotion-css="1ebhcfx">.css-1ebhcfx{box-sizing:border-box;margin:0;min-width:0;color:#707A8A;font-size:12px;padding-top:8px;}</style><div data-bn-type="text" class="css-1ebhcfx">2021-12-16 13:30</div><style data-emotion-css="vwmr9u">.css-vwmr9u{box-sizing:border-box;margin:0;min-width:0;overflow-wrap:break-word;padding-top:24px;padding-bottom:32px;}.css-vwmr9u a,.css-vwmr9u a > *{color:#C99400;word-break:break-all;-webkit-text-decoration:none;text-decoration:none;}.css-vwmr9u figure{margin-left:0;}.css-vwmr9u img{margin-left:0;}.css-vwmr9u article > *{margin-bottom:8px;}@media screen and (min-width:767px){.css-vwmr9u article > *{margin-bottom:16px;}}.css-vwmr9u a:hover,.css-vwmr9u a:hover > *{color:#F0B90B;-webkit-text-decoration:underline;text-decoration:underline;}</style><div class="css-vwmr9u"><style data-emotion-css="1ii68zy">.css-1ii68zy{box-sizing:border-box;margin:0;min-width:0;display:-webkit-box;display:-webkit-flex;display:-ms-flexbox;display:flex;-webkit-flex-direction:column;-ms-flex-direction:column;flex-direction:column;font-weight:400;}.css-1ii68zy img{width:100%;}.css-1ii68zy iframe{margin:auto;}.css-1ii68zy figcaption{text-align:center;font-size:12px;line-height:24px;margin-top:-16px;margin-bottom:24px;color:#76808F;}@media screen and (min-width:767px){.css-1ii68zy figcaption{font-size:12px;line-height:24px;margin-top:-12px;margin-bottom:32px;}}@media screen and (min-width:1023px){.css-1ii68zy figcaption{font-size:12px;line-height:24px;margin-top:-12px;margin-bottom:32px;}}</style><article class="css-1ii68zy"><style data-emotion-css="3fpgoh">.css-3fpgoh{box-sizing:border-box;margin:0;min-width:0;font-size:14px;line-height:28px;margin-bottom:16px;color:#1E2026;}@media screen and (min-width:767px){.css-3fpgoh{font-size:16px;line-height:28px;margin-bottom:24px;}}@media screen and (min-width:1023px){.css-3fpgoh{font-size:16px;line-height:28px;margin-bottom:24px;}}</style><div class="css-3fpgoh"><style data-emotion-css="1vsinja">.css-1vsinja{box-sizing:border-box;margin:0;min-width:0;color:#000000;}</style><span class="css-1vsinja"><style data-emotion-css="1lohbqv">.css-1lohbqv{box-sizing:border-box;margin:0;min-width:0;font-weight:600;}</style><strong class="css-1lohbqv">Fellow Binancians,</strong></span></div><div class="css-3fpgoh"><style data-emotion-css="1vaed0j">.css-1vaed0j{box-sizing:border-box;margin:0;min-width:0;color:#1e2026;}</style><span class="css-1vaed0j">Binance will support the bZx Protocol Token (BZRX) token swap and redenomination plan to OokiDAO Token (OOKI). Further details about this change are shown in the timeline below:</span></div><style data-emotion-css="e7d7y6">.css-e7d7y6{box-sizing:border-box;margin:0;min-width:0;display:-webkit-box;display:-webkit-flex;display:-ms-flexbox;display:flex;-webkit-flex-direction:column;-ms-flex-direction:column;flex-direction:column;font-size:14px;line-height:24px;color:#1E2026;margin-bottom:16px;}@media screen and (min-width:767px){.css-e7d7y6{font-size:16px;line-height:24px;margin-bottom:24px;}}@media screen and (min-width:1023px){.css-e7d7y6{font-size:16px;line-height:24px;margin-bottom:24px;}}</style><ul class="css-e7d7y6"><style data-emotion-css="usuhj8">.css-usuhj8{box-sizing:border-box;margin:0;min-width:0;margin-bottom:4px;}@media screen and (min-width:767px){.css-usuhj8{margin-bottom:16px;}}@media screen and (min-width:1023px){.css-usuhj8{margin-bottom:16px;}}.css-usuhj8:last-child{margin-bottom:0;}</style><li class="css-usuhj8"><span class="css-1vaed0j">Deposits and withdrawals of bZx Protocol Token (BZRX) will be suspended at 2021-12-20 02:00(UTC). Please ensure that you leave sufficient time for your BZRX deposits to be fully processed prior to this time. </span></li><li class="css-usuhj8"><span class="css-1vaed0j">Binance will delist all existing BZRX spot trading pairs (BZRX/BTC, BZRX/USDT, and BZRX/BUSD) and cancel all pending BZRX spot orders at 2021-12-20 04:00 (UTC). </span></li><li class="css-usuhj8"><span class="css-1vaed0j">At </span><span class="css-1vsinja">2021-12-16 13:00 (UTC)</span><span class="css-1vaed0j">, Binance will suspend BZRX/BTC, BZRX/USDT and BZRX/BUSD isolated margin borrowing.</span></li><li class="css-usuhj8"><span class="css-1vaed0j">At 2021-12-19 02:00 (UTC), we will close all BZRX margin positions, conduct an automatic settlement and cancel all pending BZRX margin orders, and then delist the BZRX/BTC, BZRX/USDT and BZRX/BUSD isolated margin trading pairs. A separate announcement will be made for relisting.</span></li><li class="css-usuhj8"><span class="css-1vsinja">At 2021-12-16 13:00 (UTC), Binance will adjust the maximum leverage for the BZRX/USDT futures contracts to 25x. Please note that existing positions will not be affected. For further details please refer to </span><style data-emotion-css="li4l4s">.css-li4l4s{box-sizing:border-box;margin:0;min-width:0;display:inline;color:#F0B90B;}.css-li4l4s:visited{color:#F0B90B;}.css-li4l4s:hover{color:#F0B90B;opacity:0.5;}</style><a href="https://www.binance.com/en/support/faq/360033162192" class="css-li4l4s"><style data-emotion-css="1f5vusx">.css-1f5vusx{box-sizing:border-box;margin:0;min-width:0;color:#1155cc;}</style><span class="css-1f5vusx">Leverage and Margin of USDT Futures Contracts</span></a><span class="css-1vsinja"> and the </span><a href="https://www.binance.com/en/futures/trading-rules/perpetual" class="css-li4l4s"><span class="css-1f5vusx">Trading Rules</span></a><span class="css-1vsinja"> page. </span></li><li class="css-usuhj8"><span class="css-1vsinja">At </span><span class="css-1vaed0j">2021-12-19 02:00  (UTC), </span><span class="css-1vsinja">Binance Futures will close all BZRX futures positions, conduct an automatic settlement and cancel all pending orders on </span><span class="css-1vaed0j">BZRX/</span><span class="css-1vsinja">USDT futures contracts, and then delist these contracts</span><span class="css-1vaed0j">. Please refer to the </span><a href="https://www.binance.com/en/support/articles/dd60dfbf654d4055aa6b217ea6d5ddba" class="css-li4l4s"><span class="css-1f5vusx">Delisting Process of Futures Contracts</span></a><span class="css-1vaed0j"> for more details. A separate announcement will be made for relisting. Please be aware that in the event of extreme price movement or deviation from the index price, Binance will undertake additional protective measures, including but not limited to changing the constituents of the price index and </span><span class="css-1vsinja">using the</span><a href="https://www.binance.com/en/support/faq/360033525071" class="css-li4l4s"><span class="css-1f5vusx"> Last Price Protected</span></a><span class="css-1vsinja"> mechanism to update the Mark Price. For further details, please refer to the </span><a href="https://www.binance.com/en/support/faq/547ba48141474ab3bddc5d7898f97928" class="css-li4l4s"><span class="css-1f5vusx">Price Index.</span></a></li><li class="css-usuhj8"><style data-emotion-css="1kcwta2">.css-1kcwta2{box-sizing:border-box;margin:0;min-width:0;color:#0f0f0f;}</style><span class="css-1kcwta2">Following which, we will recover all BZRX balances and begin the distribution of OOKI to all eligible users at a ratio of 1 BZRX = 10 OOKI.</span></li><li class="css-usuhj8"><span class="css-1vaed0j">Trading will then open for OOKI/USDT and OOKI/BUSD spot trading pairs at 2021-12-24 04:00 (UTC). </span></li><li class="css-usuhj8"><span class="css-1vaed0j">Binance will make a separate announcement after the token swap is completed to notify users when deposits and withdrawals of OOKI will be opened.</span></li><li class="css-usuhj8"><span class="css-1vaed0j">Thereafter, users will be able to use the </span><a href="https://www.binance.com/en/buy-sell-crypto/convert" class="css-li4l4s"><span class="css-1f5vusx">convert function</span></a><span class="css-1vaed0j"> to swap their BZRX for OOKI tokens.</span></li><li class="css-usuhj8"><span class="css-1kcwta2">New ERC-20 token contract (OOKI): </span><a href="https://etherscan.io/token/0x0De05F6447ab4D22c8827449EE4bA2D5C288379B" class="css-li4l4s"><span class="css-1f5vusx">0x0De05F6447ab4D22c8827449EE4bA2D5C288379B</span></a></li></ul><div class="css-3fpgoh"><span class="css-1vaed0j">Please note: </span></div><ol class="css-e7d7y6"><li class="css-usuhj8"><span class="css-1vaed0j">E</span><span class="css-1kcwta2">xisting BZRX token holders’ percentage of ownership of the total token supply will be diluted, as the bZx Protocol DAO has voted to mint additional 23 million BZRX as part of the token swap in order to finance the token buyback of BGOV and PGOV tokens. </span></li><li class="css-usuhj8"><span class="css-1kcwta2">The additional OOKI tokens will be transferred to the bZx Protocol DAO Treasury when the token swap is complete.</span></li></ol><div class="css-3fpgoh"><span class="css-1vaed0j">For further information, please refer to the following: </span></div><ul class="css-e7d7y6"><li class="css-usuhj8"><a href="https://bzx.network/blog/exchange-guide-bzrx-to-ooki-migration" class="css-li4l4s"><span class="css-1f5vusx">Exchange Guide for Migrating BZRX to Ooki Token</span></a></li><li class="css-usuhj8"><a href="https://forum.bzx.network/t/bzrx-token-migration-and-split/422" class="css-li4l4s"><span class="css-1f5vusx">BZRX Token Migration and Split</span></a><span class="css-1vsinja"> (</span><a href="https://snapshot.org/#/bzx.eth/proposal/QmQWVLPvuhgwTwkKHo2haQskakq44HftTUaLppYAuFWEmj" class="css-li4l4s"><span class="css-1f5vusx">vote results</span></a><span class="css-1vsinja">)</span></li><li class="css-usuhj8"><a href="https://forum.bzx.network/t/bzrx-pgov-bgov-token-buyback/423" class="css-li4l4s"><span class="css-1f5vusx">BZRX PGOV / BGOV Token Buyback</span></a><span class="css-1vsinja"> </span><a href="https://snapshot.org/#/bzx.eth/proposal/QmY5HX1aU8G1UcYzvQb1RyFcd2TkwZ3pCz5rPRFDy5QheZ" class="css-li4l4s"><span class="css-1f5vusx">(vote results)</span></a></li><li class="css-usuhj8"><a href="https://bzx.network/blog/bzx-compensation-plan" class="css-li4l4s"><span class="css-1f5vusx">bZx Compensation Plans</span></a></li></ul><div class="css-3fpgoh"><span class="css-1vsinja"><strong class="css-1lohbqv">Risk warning</strong>: Cryptocurrency trading is subject to high market risk. Please make your trades cautiously. You are advised that Binance is not responsible for your trading losses.</span></div><div class="css-3fpgoh"><span class="css-1vsinja">Thanks for your support!</span></div><div class="css-3fpgoh"><span class="css-1vsinja">Binance Team</span></div><div class="css-3fpgoh"><span class="css-1vsinja">2021-12-16</span><br class="css-vurnku"/></div><div class="css-3fpgoh"><a href="https://binance.onelink.me/y874/803c5d7d" class="css-li4l4s"><span class="css-1f5vusx">Trade on-the-go with Bi