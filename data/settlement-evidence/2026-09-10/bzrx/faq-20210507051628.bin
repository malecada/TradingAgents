<body>
  <script id="__APP_DATA" type="application/json">{"routeProps":{"11c1":{"articleDetail":{"id":30021,"title":"Delisting Process of A Futures Contract","body":"{\"node\":\"root\",\"child\":[{\"node\":\"element\",\"tag\":\"p\",\"child\":[{\"node\":\"element\",\"tag\":\"strong\",\"child\":[{\"node\":\"text\",\"text\":\"What is Delisting\"}]}]},{\"node\":\"element\",\"tag\":\"p\",\"child\":[{\"node\":\"text\",\"text\":\"Delisting is the removal of a listed asset from an exchange. The delisting can be voluntary or involuntary and usually results when a project ceases operations, does not meet listing requirements, undergo a hard fork, split or reverse split occasions with new coins.\u0026nbsp;There are numerous factors that could go into the decision for an exchange to delist an asset.\u0026nbsp;\"}]},{\"node\":\"element\",\"tag\":\"p\",\"child\":[{\"node\":\"text\",\"text\":\"\u0026nbsp;\"}]},{\"node\":\"element\",\"tag\":\"p\",\"child\":[{\"node\":\"element\",\"tag\":\"strong\",\"child\":[{\"node\":\"text\",\"text\":\"What to Expect During Delisting\"}]},{\"node\":\"element\",\"tag\":\"br\"},{\"node\":\"text\",\"text\":\"When an asset gets delisted from an exchange, all of its trading pairs will stop trading and be removed. An official announcement will be released prior to the cessation of the trading date to acknowledge all users. Users are still able to trade until the cessation of the trading date.\u0026nbsp;\"}]},{\"node\":\"element\",\"tag\":\"p\",\"child\":[{\"node\":\"text\",\"text\":\"During the last hour on the cessation of trading date, the mark price of the delisted asset\u0026nbsp;will be calculated as the average of the price index every second over the last hour before cessation, i.e. total 3600 mark price.\u0026nbsp;\"}]},{\"node\":\"element\",\"tag\":\"p\",\"child\":[{\"node\":\"text\",\"text\":\"It is important to note that users are not allowed to open positions of the delisted asset and are only allowed to close the position i.e. placing reduce-only orders 10 minutes before the cessation of trading.\u0026nbsp;\"}]},{\"node\":\"element\",\"tag\":\"p\",\"child\":[{\"node\":\"text\",\"text\":\"If users choose to hold the position until the cessation of trading, the position will be automatically closed or settled. Please be noted trading fees will be charged for the automatic settlement. All unrealized P/L is calculated at the time of settlement and converted into realized P/L.\u0026nbsp;\"}]},{\"node\":\"element\",\"tag\":\"p\",\"child\":[{\"node\":\"text\",\"text\":\"Traders are advised to close any open positions of the delisted asset before the cessation of trading to avoid automatic settlement of position.\"}]}]}","code":"dd60dfbf654d4055aa6b217ea6d5ddba","publishDate":1601606198950,"relatedArticles":[{"id":19809,"code":"360033544231","title":"Fee Schedule of Binance Futures","body":null,"type":2,"catalogId":null,"catalogName":null,"publishDate":null},{"id":19810,"code":"360033180732","title":"Binance Futures Service Agreement","body":null,"type":2,"catalogId":null,"catalogName":null,"publishDate":null},{"id":43185,"code":"e8bed559093341b1a89380ab0db5d5cd","title":"Cross Collateral Service Agreement","body":null,"type":2,"catalogId":null,"catalogName":null,"publishDate":null}],"articleType":2,"firstCatalogName":"Crypto Derivatives","firstCatalogId":4,"secondCatalogName":"Futures Contracts","secondCatalogId":18,"thirdCatalogName":"Futures Service and Agreement","thirdCatalogId":65,"seoTitle":"Delisting Process of A Futures Contract","seoKeywords":" ","seoDesc":"What is Delisting Delisting is the removal of a listed asset from an exc...","version":"1"},"isNeedEnForDefault":false}},"dynamicIds":["RCSn","sWZW","IvR9","yWqD"],"appProps":{"locale":"en","configs":{"header":{"logo":{"name":"h-binanceen","width":"120px","height":"24px","link":"https://www.%suffixOrigin%/%locale%"},"list":[{"id":124,"filterId":3,"module":"list","title":{"type":"icon","title":"ba-Products","openType":"_self","icon":"h-top-menu-s","show